  "pier1": {
    "featured": [
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/68-SH2-232Mosaic-1.jpg",
        "local": "media/uploads/2022/03/68-SH2-232Mosaic-1.jpg",
        "title": "Sharpless 232 in Auriga",
        "text": "The diffuse nebula is massive, the biggest in the Auriga nebula complex, but it is very faint and hard to capture. Hundreds of subexposures were used to try to bring out its dusty detail and dim contrast. Only the Hydrogen and Sulphur channels shine; Oxygen contributed to the star colors."
      },
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/69-NGC4631Galaxy.jpg",
        "local": "media/uploads/2022/03/69-NGC4631Galaxy.jpg",
        "title": "The Whale Galaxy",
        "text": "This interesting edge-on galaxy in Canes Venatici looks a bit like a whale with its pup underneath. Of particular note is its off-center starburst region, and it\u2019s a good fit to be number 281 in Arp\u2019s list of unusual galaxies. The nearby colliding Hockey Stick galaxies can be seen in the upper right of this image."
      },
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/70-NGC1499-California-1.jpg",
        "local": "media/uploads/2022/03/70-NGC1499-California-1.jpg",
        "title": "The California Nebula in Blue",
        "text": "This nebula is found just \u2018above\u2019 the Seven Sisters of the Pleiades in Perseus. When processing the almost pure hydrogen glow, image processors must choose which color to make it, and we chose a cooler blue and purple rendering over the traditional pink and red this time."
      },
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/71A-NGC6992-BlueRed-1-e1646430875551.jpg",
        "local": "media/uploads/2022/03/71A-NGC6992-BlueRed-1-e1646430875551.jpg",
        "title": "The Eastern Veil in Red & Blue",
        "text": "Part of a much larger nebulous complex in Cygnus, the Eastern Veil features delicate wisps of glowing hydrogen and oxygen, the remnants of an exploding star that may someday seed a new planetary system with raw ingredients."
      },
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/71B-NGC6992-BlueGold-1-e1646430848638.jpg",
        "local": "media/uploads/2022/03/71B-NGC6992-BlueGold-1-e1646430848638.jpg",
        "title": "The Veil Nebula in Blue and Gold",
        "text": "When choosing narrowband palettes to highlight specific wavelengths, sometimes the traditional choices aren\u2019t necessarily the best. This blend of the Veil jumped out to us with a thin spine of green over the electric blue and mainly gold structures."
      },
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/72-OrionM42-1.jpg",
        "local": "media/uploads/2022/03/72-OrionM42-1.jpg",
        "title": "The Orion Nebula",
        "text": "How did the most famous and easily viewed nebula drop all the way down to number 42 on Charles Messier\u2019s famous list of non-comets? This new view of the classic target shows our sharpest dust features yet."
      },
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/73-M63Galaxy.jpg",
        "local": "media/uploads/2022/03/73-M63Galaxy.jpg",
        "title": "The Sunflower Galaxy",
        "text": "Messier 63, sometimes called the Sunflower Galaxy, is known as a \u2018flocculent\u2019 galaxy, a structure without well defined spiral arms. In these unusual arms, astronomers look for data about star formation."
      },
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/74-NinePanelMosaic-1.jpg",
        "local": "media/uploads/2022/03/74-NinePanelMosaic-1.jpg",
        "title": "The Heart of the Swan",
        "text": "This massive 9 panel mosaic features the immense field of nebulosity in Cygnus constellation. It took dozens of hours to register and align the panels in place, and the final working file was almost 10 GB in size."
      },
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/75-NGC6823-1.jpg",
        "local": "media/uploads/2022/03/75-NGC6823-1.jpg",
        "title": "Nebula in the Open Cluster",
        "text": "The field of glowing hydrogen lies among an open cluster grouping of stars. It has a prominent and recognizable pillar, similar to the famous Pillars of Creation and the Spire in M16."
      }
    ],

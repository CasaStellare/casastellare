  "about": {
    "intro": [
      "The Casa Stellare team is Jeff McFarlin, Jerry Smith, and Josh Lake.",
      "We hope you enjoy the web site and hard work of the team in collecting and developing the data from our selections of galaxies, nebulae and other amazing and wonderful objects. We welcome you all and hope you will come back soon to see what is next!"
    ],
    "people": [
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/Jeff-e1646683445203.jpeg",
        "local": "media/uploads/2022/03/Jeff-e1646683445203.jpeg",
        "name": "Jeff",
        "bio": "Jeff McFarlin, co-founder, owner and primary operator of Casa Stellare. He manages all technical aspects of the observatory, and runs the imaging sessions. He lives in northern Virginia with his wife and two kids, and by day works in I.T. Jeff began his serious astrophotography pursuits in 2009."
      },
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/Jerry.png",
        "local": "media/uploads/2022/03/Jerry.png",
        "name": "Jerry",
        "bio": "Jerry Smith, co-founder of Casa Stellare. Former Air Traffic Supervisor/Manager and Controller from Miami Air Route Traffic Control Center (ARTCC). Still works for FAA as Contractor (L3Harris) implementing Next Gen Data Communications between Pilots and Controllers."
      },
      {
        "src": "https://casastellare.com/wp-content/uploads/2022/03/Lake-Avatar-e1646683579557.png",
        "local": "media/uploads/2022/03/Lake-Avatar-e1646683579557.png",
        "name": "Josh",
        "bio": "Josh is the Casa Stellare team\u2019s image processor. By day, Josh is a physics, engineering, and astronomy teacher at Pomfret School, a CT independent boarding school. He runs the Pomfret Olmsted Observatory and teaches students how to use PixInsight to process astrophotography. In 2012, Josh won the Public and Jury Prizes for the international Hubble\u2019s Hidden Treasures contest."
      }
